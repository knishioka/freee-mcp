{
  "name": "freee-mcp",
  "version": "0.1.0",
  "description": "MCP server for freee accounting API integration",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "freee-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "setup-auth": "node scripts/setup-auth.js",
    "prepare": "npm run build && (husky || true)",
    "gitleaks": "gitleaks detect --source . --verbose --no-banner",
    "gitleaks:ci": "gitleaks detect --source . --verbose --no-banner --exit-code 1"
  },
  "keywords": [
    "mcp",
    "freee",
    "accounting",
    "api"
  ],
  "author": "knishioka",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axios": "1.18.0",
    "debug": "^4.4.3",
    "dotenv": "^16.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/debug": "^4.1.12",
    "@types/node": "^20.19.0",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^8.57.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "tsx": "^4.19.4",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "bash -c 'npm run typecheck'"
    ],
    "*": [
      "gitleaks detect --source . --verbose --no-banner --redact"
    ]
  }
}
